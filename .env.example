# Base URL of the backend Cloudflare Worker (no trailing slash).
# The app POSTs to ${NEXT_PUBLIC_API_URL}/api/assess
NEXT_PUBLIC_API_URL=http://localhost:8787

# Cloudflare Turnstile site key.
# For local development use Cloudflare's test key 1x00000000000000000000AA,
# which always passes (pair it with the matching test secret key on the backend).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# "true" skips the network and Turnstile and returns fake results after 2 seconds.
NEXT_PUBLIC_USE_MOCK=true
